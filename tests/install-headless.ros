#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- "$0" "$@"
|#
(ros:ensure-asdf)
#+sbcl (sb-ext:disable-debugger)
(load (merge-pathnames "../scripts/installer.lisp" *load-truename*))
(defpackage :cl-lsp/install-tests (:use :cl))
(in-package :cl-lsp/install-tests)

(defun signals-error-p (function)
  (handler-case (progn (funcall function) nil) (error () t)))

(defun main (&rest args)
  (declare (ignore args))
  (let* ((root (uiop:ensure-directory-pathname
                (string-trim '(#\Newline #\Return)
                             (uiop:run-program '("mktemp" "-d" "/tmp/cl-lsp-tests.XXXXXX") :output :string))))
         (cache (uiop:getenv "XDG_CACHE_HOME")))
    (unwind-protect
         (progn
           (setf (uiop:getenv "XDG_CACHE_HOME") (namestring (merge-pathnames "cache/" root)))
           (let ((sentinel (merge-pathnames "sentinel" root)))
             (with-open-file (out sentinel :direction :output) (write-string "keep" out))
             (assert (signals-error-p (lambda () (cl-lsp/installer:install root))))
             (assert (equal "keep" (uiop:read-file-string sentinel))))
           (let ((value "a 'quoted' path; $(false)"))
             (assert (equal value
                            (uiop:run-program
                             (list "sh" "-c" (format nil "printf %s ~A" (cl-lsp/installer::shell-quote value)))
                             :output :string))))
           (format t "Installer checks passed.~%"))
      (setf (uiop:getenv "XDG_CACHE_HOME") (or cache "")))))
