#!/bin/sh
#|-*- mode:lisp -*-|#
#| Start the runtime prepared by ros install askdkc/cl-lsp.
exec ros -Q -- "$0" "$@"
|#
(ros:ensure-asdf)
#+sbcl (sb-ext:disable-debugger)

(defpackage :ros.script.server.3694408704
  (:use :cl))
(in-package :ros.script.server.3694408704)

(defparameter *runtime-pointer*
  (merge-pathnames "cl-lsp-runtime.sexp" *load-truename*))

(defun main (&rest argv)
  (unless (probe-file *runtime-pointer*)
    (error "CL-LSP runtime is missing. Run: ros install askdkc/cl-lsp"))
  (let* ((*read-eval* nil)
         (launcher (with-open-file (in *runtime-pointer*) (read in))))
    (unless (and (stringp launcher) (probe-file launcher))
      (error "CL-LSP runtime is unavailable. Run: ros install askdkc/cl-lsp"))
    (ros:exec (cons launcher argv))))

;;; vim: set ft=lisp lisp:
